# Supabase — pegue esses valores em Project Settings > API no supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Service role key — NUNCA exponha no navegador, só é usada no servidor (Server Actions)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Senha do admin (Ícaro). Troque quando quiser, sem precisar mexer no código.
ADMIN_PASSWORD=icsouza2026

# Chave secreta para assinar o cookie de sessão do cliente. Gere uma string aleatória longa.
SESSION_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Resend — envio de e-mails automáticos. Pegue a chave em resend.com > API Keys.
RESEND_API_KEY=re_sua_chave_aqui

# Remetente dos e-mails. Precisa ser um endereço do domínio que você verificou na Resend.
EMAIL_FROM="Clube de Recomendações IC Souza <clube@avisos.icsouza.com.br>"

# Para onde vão os avisos de "nova recomendação" e "novo resgate solicitado".
ADMIN_NOTIFY_EMAIL=icaromsouza13@gmail.com

# Protege a rotina automática diária (bônus de 90 dias + lembrete de inatividade).
# Gere uma string aleatória — a Vercel usa essa mesma variável para autenticar o cron sozinha.
CRON_SECRET=troque-por-outra-string-aleatoria
